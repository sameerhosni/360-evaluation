# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit it.

# Postgres connection string. Free option: https://neon.tech (create project, copy
# the "pooled connection" string). For local SQLite dev, change `provider` in
# prisma/schema.prisma back to "sqlite" and set DATABASE_URL="file:./dev.db".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Anthropic API key — get one at https://console.anthropic.com/
# Optional: the app runs without it, but Twin chat, Advocate Brief,
# Auto-Achievement Detection, and Sentinel explanations fall back to
# seeded content when missing.
ANTHROPIC_API_KEY=""

# Default model — Opus 4.7 has the strongest Arabic/English bilingual
# performance for this domain. Swap to claude-sonnet-4-6 for cheaper
# iteration during development.
ANTHROPIC_MODEL="claude-opus-4-7"
